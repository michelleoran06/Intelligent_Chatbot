# Copia este archivo como .env y ajusta los valores. El archivo .env NO se sube a GitHub.

# Entorno: development (por defecto) o production.
# Con ENV=production el backend NO arranca si faltan OPERATOR_PASSWORD_HASH, AUTH_SECRET_KEY o ALLOWED_ORIGINS.
ENV=development

# Backend
CONFIDENCE_THRESHOLD=0.75
CONFIDENCE_DIVISOR=2.0
USE_REJECTION_EXAMPLES=true
EMBEDDING_CONCURRENCY=2
SERVER_THREADS=200
EMBEDDING_BATCH_SIZE=16
# Linux (Docker/Render): limita las arenas de malloc para reducir la memoria del proceso
MALLOC_ARENA_MAX=2
MAX_QUERY_LENGTH=500
# Si se define, crear/editar/borrar entradas de la base de conocimiento exige este token
ADMIN_TOKEN=

# Interfaces de Streamlit (en Streamlit Community Cloud se ponen en "Secrets")
BACKEND_URL=http://127.0.0.1:8000

# Gemini (Fase 3). Valores falsos: pon tus keys reales solo en .env o en Render.
GEMINI_API_KEY_1=tu-key-de-gemini-1-aqui
# Opcional: segunda key de respaldo
GEMINI_API_KEY_2=
GEMINI_MODEL=gemini-flash-modelo-por-definir

# Autenticación del operador (Fase 2)
# Hash bcrypt de la contraseña (se generará con scripts/hash_password.py)
OPERATOR_PASSWORD_HASH=hash-bcrypt-falso-de-ejemplo
# Clave larga y aleatoria para firmar tokens, p. ej.: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=cambia-esta-clave-por-una-aleatoria
# Orígenes permitidos para CORS, separados por comas
ALLOWED_ORIGINS=http://localhost:8501,https://tu-app.streamlit.app
