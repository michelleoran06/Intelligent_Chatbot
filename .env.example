# Copia este archivo como .env y ajusta los valores. El archivo .env NO se sube a GitHub.

# Backend
CONFIDENCE_THRESHOLD=0.75
CONFIDENCE_DIVISOR=2.0
USE_REJECTION_EXAMPLES=true
EMBEDDING_CONCURRENCY=2
SERVER_THREADS=200
EMBEDDING_BATCH_SIZE=16
# Linux (Docker/Render): limita las arenas de malloc para reducir la memoria del proceso
MALLOC_ARENA_MAX=2
MAX_QUERY_LENGTH=500
# Si se define, crear/editar/borrar entradas de la base de conocimiento exige este token
ADMIN_TOKEN=

# Interfaces de Streamlit (en Streamlit Community Cloud se ponen en "Secrets")
BACKEND_URL=http://127.0.0.1:8000
